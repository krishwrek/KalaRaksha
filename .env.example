# KalaRaksha Environment Configuration Template
# Duplicate this file to .env and configure for your deployment environment.
# DO NOT COMMIT REAL PRODUCTION SECRETS TO GIT.

# Application Environment (development, staging, production)
ENVIRONMENT=production
DEBUG=false

# Server Configuration
PORT=8000
HOST=0.0.0.0
WORKERS=4

# Security & CORS Settings
# Set specific origins in production (e.g., https://kalaraksha.org,https://app.kalaraksha.org)
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# File Upload Security Limits
MAX_UPLOAD_SIZE_MB=15
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
MAX_IMAGE_DIMENSION_PX=4096
DECOMPRESSION_BOMB_LIMIT_PIXELS=178956970

# Rate Limiting (Requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=20

# Optional API Security Key (If set, requests to /api/v1/* require header: X-API-Key)
API_SECRET_KEY=

# Legal & Compliance Contact
LEGAL_CONTACT_EMAIL=compliance@kalaraksha.org
DMCA_AGENT_NAME=KalaRaksha Conservation Copyright Agent
DMCA_AGENT_EMAIL=dmca@kalaraksha.org
DMCA_POSTAL_ADDRESS="Heritage Preservation Directorate, 120 Culture Way, New Delhi, India"
